MONGO_URI=mongodb://127.0.0.1:27017/collabsphere
# Secret used to sign rotating check-in QR tokens
QR_SECRET=change-me

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (and your Vercel URL)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only these email domains may sign in (comma separated; empty = any Google account)
ALLOWED_EMAIL_DOMAINS=ds.study.iitm.ac.in,es.study.iitm.ac.in
# These emails become admins on first sign-in
ADMIN_EMAILS=

# "true" shows a demo-user switcher next to Google login (keep on for jury demo, off for real use)
DEV_AUTH=true
